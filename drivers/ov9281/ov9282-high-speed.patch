+static int ov9282_apply_strip_y_offset(struct ov9282 *ov9282)
+{
+	const struct ov9282_mode *mode = ov9282->cur_mode;
+	int offset = ov9282_strip_y_offset(mode);
+	int sensor_y_start;
+	u32 y_start;
+	u32 y_end;
+	int ret;
+
+	if (mode->width == 320 && mode->height == 200) {
+		/* Preserve InnoMaker's 516-row native window around sensor center. */
+		y_start = 150 + 2 * offset;
+		y_end = 665 + 2 * offset;
+	} else if (mode->width == 640 &&
+		   (mode->height == 200 || mode->height == 100)) {
+		sensor_y_start = mode->crop.top - OV9282_PIXEL_ARRAY_TOP + 2 * offset;
+		y_start = sensor_y_start;
+		/* The sensor window includes the eight dummy rows on each edge. */
+		y_end = y_start + mode->crop.height + 15;
+	} else {
+		return 0;
+	}
+
+	ret = ov9282_write_reg(ov9282, OV9282_REG_Y_ADDR_START, 2, y_start);
+	if (ret)
+		return ret;
+
+	ret = ov9282_write_reg(ov9282, OV9282_REG_Y_ADDR_END, 2, y_end);
+	if (!ret && offset)
+		dev_info(ov9282->dev,
+			 "shifted %ux%u strip by %+d output rows (sensor y %u-%u)",
+			 mode->width, mode->height, offset, y_start, y_end);
+
+	return ret;
+}
