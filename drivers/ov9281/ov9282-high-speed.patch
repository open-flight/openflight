+static int ov9282_strip_y_offset(const struct ov9282_mode *mode)
+{
+	int max_offset;
+
+	if (mode->width == 320 && mode->height == 200)
+		return clamp(strip_y_offset, -75, 75);
+
+	if (!(mode->width == 640 &&
+	      (mode->height == 200 || mode->height == 100)))
+		return 0;
+
+	/* Two native sensor rows produce one output row in the strip modes. */
+	max_offset = (OV9282_PIXEL_ARRAY_HEIGHT - mode->crop.height) / 4;
+	return clamp(strip_y_offset, -max_offset, max_offset);
+}
